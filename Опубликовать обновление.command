#!/bin/bash
# Двойной клик по этому файлу публикует обновление приложения.
cd "$(dirname "$0")" || exit 1

echo "Публикую обновление…"
echo

if ./deploy.sh "Обновление приложения"; then
  echo
  echo "Готово. Откройте «Словарик» на телефоне с интернетом — обновление подтянется."
else
  echo
  echo "Не получилось опубликовать. Проверьте интернет и попробуйте ещё раз."
fi

echo
read -n 1 -s -r -p "Нажмите любую клавишу, чтобы закрыть окно…"
echo
